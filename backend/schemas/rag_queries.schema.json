{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "disasterai/rag_queries.schema.json",
  "title": "RAG query writer output",
  "description": "Contract from prompts/rag_query/v1.md. n8n sends each query to POST /search with the rag_topic of the incident.",
  "type": "object",
  "required": ["queries"],
  "additionalProperties": false,
  "properties": {
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "language", "need"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 3},
          "language": {"enum": ["en", "fr"]},
          "need": {"type": "string"}
        }
      }
    }
  }
}
