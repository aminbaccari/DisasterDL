# Copy this file to .env and fill in the values. Never commit .env.

# Free key from Google AI Studio
GEMINI_API_KEY=

# The Gemini docs list gemini-3.8-flash as a stable Flash model on 2026-10-15.
# gemini-2.5-flash is listed as "access limited to past users", so do not use it with a new key.
# Confirm in Google AI Studio that your key can call the model and check your free-tier limits.
GEMINI_MODEL=gemini-3.8-flash

# Local multilingual embedding model (English and French corpus)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Chunking strategy used by the RAG service: fixed or section.
# Evaluation on 2026-10-16 (docs/EVIDENCE_LOG.md): section was better on both query sets.
DEFAULT_STRATEGY=section

# n8n and RAG service addresses
N8N_URL=http://localhost:5678
# Port 8010: 8000 was already used on the dev machine.
RAG_SERVICE_URL=http://localhost:8010

# Other LLM providers for the fallback chain (backend/llm_chain.py). All optional, leave empty to skip a provider.
# Groq: console.groq.com, OpenRouter: openrouter.ai. Create the keys yourself, never commit them.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vision: a separate chain for calls with an image, so they do not use the quota of the text chain (docs/VISION_ARCHITECTURE.md).
# Providers: ollama (local server, no key), hf (Hugging Face Inference Providers, HF_TOKEN), gemini, groq, openrouter.
# Local model: Ollama in Docker with a GPU (docs/VISION_ARCHITECTURE.md). Use the instruct tag: the default qwen3-vl:4b is a
# thinking model and returned an empty message at 300 tokens. Leave VISION_CHAIN empty to use LLM_CHAIN for images (only models whose name suggests vision support are tried).
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434/v1
VISION_CHAIN=ollama:qwen3-vl:4b-instruct,gemini:gemini-3.6-flash,openrouter:nvidia/nemotron-3.5-super-vl:free

# Order in which models are tried, first to last: provider:model, comma separated.
# A provider whose key is empty is skipped. Model names change: list them with scripts/llm_ping.py --list <provider> and verify with
# scripts/llm_ping.py --model provider:model --json. Image requests only go to models that accept images (the vision step).
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,openrouter:nvidia/nemotron-3-super-120b-a12b:free,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-31b-it:free
