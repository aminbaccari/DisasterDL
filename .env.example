# Copy this file to .env and fill in the values. Never commit .env.

# Free key from Google AI Studio
GEMINI_API_KEY=

# The Gemini docs list gemini-3.8-flash as a stable Flash model on 2026-10-15.
# gemini-2.5-flash is listed as "access limited to past users", so do not use it with a new key.
# Confirm in Google AI Studio that your key can call the model and check your free-tier limits.
GEMINI_MODEL=gemini-3.8-flash

# Local multilingual embedding model (English and French corpus)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Chunking strategy used by the RAG service: fixed or section.
# Change it after the retrieval evaluation (python -m rag.evaluate) shows which is better.
DEFAULT_STRATEGY=fixed

# n8n and RAG service addresses
N8N_URL=http://localhost:5678
RAG_SERVICE_URL=http://localhost:8000
